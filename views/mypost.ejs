<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>My posts · NoteNest</title><link rel="stylesheet" href="/stylesheet/profile.css">
<script src="/javascript/mobileNav.js" defer></script></head>
<body class="app-page">
<header class="mobile-header">
    <a class="brand" href="/profile">NoteNest</a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-drawer">
        <span></span><span></span><span></span>
    </button>
</header>
<div class="mobile-overlay" aria-hidden="true"></div>
<nav class="mobile-drawer" id="mobile-drawer" aria-label="Mobile navigation">
    <div class="drawer-head">
        <div>
            <span class="drawer-label">NAVIGATION</span>
            <strong>NoteNest</strong>
        </div>
        <button class="drawer-close" type="button" aria-label="Close navigation">×</button>
    </div>
    <div class="drawer-profile">
        <div class="drawer-avatar"><img src="/images/upload/<%= founduser.profilePic %>" alt=""></div>
        <div><strong><%= founduser.name %></strong><span>@<%= founduser.username %></span></div>
    </div>
    <div class="drawer-nav">
        <a href="/profile"><span>⌂</span> Home</a>
        <a href="/mypost"><span>▤</span> My posts</a>
        <a href="/profile/upload"><span>◎</span> Profile</a>
    </div>
    <a class="drawer-logout" href="/logout"><span>↪</span> Log out</a>
</nav>
<div class="app-shell">
<aside class="sidebar"><a class="brand sidebar-brand" href="/profile">NoteNest</a><nav class="side-nav"><a class="nav-item" href="/profile"><span>⌂</span> Home</a><a class="nav-item active" href="/mypost"><span>▤</span> My posts</a><a class="nav-item" href="/profile/upload"><span>◎</span> Profile</a></nav><a class="nav-item nav-logout" href="/logout"><span>↪</span> Log out</a></aside>
<main class="feed narrow-feed">
<div class="page-heading"><div><span class="eyebrow">YOUR CONTENT</span><h1>My posts</h1></div><a class="secondary-btn" href="/profile">← Back to feed</a></div>
<% if (notice) { %><div class="notice"><span>!</span><%= notice %></div><% } %>
<section class="post-list">
<% if (!founduser.post.length) { %><div class="empty-state card"><div class="empty-icon">✦</div><h3>No posts yet</h3><p>Share your first thought from the home feed.</p><a class="primary-btn small-btn" href="/profile">Create a post</a></div><% } %>
<% founduser.post.forEach(function(post){ %><article class="post-card card"><div class="post-head"><img class="avatar" src="/images/upload/<%= founduser.profilePic %>" alt="" onerror="this.onerror=null;this.src='/images/upload/profile_placeholder.jpg';"><div class="post-author"><strong><%= founduser.name %></strong><span>@<%= founduser.username %> · <%= new Date(post.date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span></div><a class="edit-link" href="/edit/<%= post._id %>">Edit</a></div><p class="post-content"><%= post.content %></p><div class="post-actions"><form action="/like/<%= post._id %>" method="POST"><button class="like-btn <%= post.likes.some(function(id){ return id.toString() === founduser._id.toString(); }) ? 'liked' : '' %>" type="submit"><span><%= post.likes.some(function(id){ return id.toString() === founduser._id.toString(); }) ? '♥' : '♡' %></span><%= post.likes.length %></button></form></div></article><% }) %>
</section></main>
<aside class="right-panel"><section class="profile-card card"><div class="profile-cover"></div><div class="profile-body"><a class="avatar avatar-lg profile-avatar" href="/profile/upload"><img src="/images/upload/<%= founduser.profilePic %>" alt="" onerror="this.onerror=null;this.src='/images/upload/profile_placeholder.jpg';"></a><h2><%= founduser.name %></h2><p>@<%= founduser.username %></p><div class="profile-stats"><div><strong><%= founduser.post.length %></strong><span>Posts</span></div><div><strong><%= founduser.age %></strong><span>Age</span></div></div></div></section></aside>
</div></body></html>
