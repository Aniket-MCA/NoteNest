<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= status %> · NoteNest</title>
    <link rel="stylesheet" href="/stylesheet/profile.css" />
  </head>
  <body class="error-page">
    <div class="error-card card">
      <span class="error-code"><%= status %></span
      ><span class="eyebrow">NOTE NEST</span>
      <h1><%= title %></h1>
      <p><%= message %></p>
      <a class="primary-btn small-btn" href="<%= backUrl %>"
        >Go back <span>→</span></a
      >
    </div>
  </body>
</html>
