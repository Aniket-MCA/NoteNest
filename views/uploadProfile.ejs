<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Profile · NoteNest</title><link rel="stylesheet" href="/stylesheet/profile.css">
<script src="/javascript/mobileNav.js" defer></script></head>
<body class="app-page"><header class="mobile-header">
    <a class="brand" href="/profile">NoteNest</a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-drawer">
        <span></span><span></span><span></span>
    </button>
</header><div class="mobile-overlay" aria-hidden="true"></div>
<nav class="mobile-drawer" id="mobile-drawer" aria-label="Mobile navigation">
    <div class="drawer-head">
        <div>
            <span class="drawer-label">NAVIGATION</span>
            <strong>NoteNest</strong>
        </div>
        <button class="drawer-close" type="button" aria-label="Close navigation">×</button>
    </div>
    <div class="drawer-profile">
        <div class="drawer-avatar"><img src="/images/upload/<%= founduser.profilePic %>" alt=""></div>
        <div><strong><%= founduser.name %></strong><span>@<%= founduser.username %></span></div>
    </div>
    <div class="drawer-nav">
        <a href="/profile"><span>⌂</span> Home</a>
        <a href="/mypost"><span>▤</span> My posts</a>
        <a href="/profile/upload"><span>◎</span> Profile</a>
    </div>
    <a class="drawer-logout" href="/logout"><span>↪</span> Log out</a>
</nav>
<div class="page-brand"><a class="brand" href="/profile">NoteNest</a></div><div class="center-page"><div class="editor-card card profile-upload-card"><div class="editor-heading"><a href="/profile">← Back to feed</a><span class="eyebrow">PROFILE</span><h1>Update your picture</h1><p>Choose a clear image that represents you.</p></div><% if (notice) { %><div class="notice"><span>!</span><%= notice %></div><% } %><div class="upload-preview"><img src="/images/upload/<%= founduser.profilePic %>" alt="Current profile picture" onerror="this.src='/images/upload/profile_placeholder.jpg'"></div><form class="upload-form" action="/profile/upload" method="POST" enctype="multipart/form-data"><label class="file-field"><span>Profile image</span><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required><small>JPG, PNG, WEBP or GIF · up to 5 MB</small></label><button class="primary-btn" type="submit">Upload picture <span>→</span></button></form></div></div></body></html>
